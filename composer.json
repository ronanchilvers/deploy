{
    "name": "ronanchilvers/deploy",
    "description": "A tool for simple deployments from common source control providers.",
    "type": "project",
    "require": {
        "defuse/php-encryption": "^2.1",
        "dflydev/fig-cookies": "^1.0",
        "guzzlehttp/guzzle": "^7.9",
        "monolog/monolog": "^2.10",
        "pda/pheanstalk": "^4.0",
        "php": "^8.4",
        "respect/validation": "^1.1",
        "robmorgan/phinx": "^0.12.0",
        "ronanchilvers/container-bridge-slim": "^2.0",
        "ronanchilvers/foundation": "^1.8",
        "ronanchilvers/orm": "^2.1",
        "ronanchilvers/sessions": "dev-master",
        "ronanchilvers/utility": "^2.0",
        "slim/slim": "^3.9",
        "slim/twig-view": "^2.3",
        "symfony/console": "^6.4",
        "symfony/process": "^6.4",
        "symfony/yaml": "^6.4"
    },
    "require-dev": {
        "jakub-onderka/php-parallel-lint": "^1.0",
        "mikey179/vfsstream": "^1.6",
        "php-parallel-lint/php-parallel-lint": "^1.3",
        "phpunit/phpunit": "^11.5"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "ronanchilvers/sessions",
                "version": "dev-master",
                "source": {
                    "type": "git",
                    "url": "https://github.com/ronanchilvers/sessions.git",
                    "reference": "1a44f5c809a7572d4e553987cc62d21a60027a01"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://codeload.github.com/ronanchilvers/sessions/zip/1a44f5c809a7572d4e553987cc62d21a60027a01"
                },
                "require": {
                    "php": "^7.3||^8.0",
                    "psr/http-message": "^1.0"
                },
                "autoload": {
                    "psr-4": {
                        "Ronanchilvers\\Sessions\\": "src"
                    }
                }
            }
        }
    ],
    "authors": [
        {
            "name": "Ronan Chilvers",
            "email": "ronan@thelittledot.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests"
        }
    },
    "config": {
        "process-timeout" : 0,
        "platform": {
            "php": "8.4.0"
        }
    },
    "scripts": {
        "serve": "/usr/bin/env php -S 0.0.0.0:8001 -t web",
        "gulp": "([ -d ./node_modules ] || npm install) && ./node_modules/.bin/gulp"
    }
}
